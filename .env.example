# MySQL container and API connection
MYSQL_ROOT_PASSWORD=<replace-with-a-strong-root-password>
MYSQL_DATABASE=campus_trade
MYSQL_USER=greenloop
MYSQL_PASSWORD=<replace-with-a-strong-application-password>

# API secrets and integrations
JWT_SECRET=<generate-a-long-random-jwt-secret>
SPRING_MAIL_HOST=<smtp-host>
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=<mail-username>
SPRING_MAIL_PASSWORD=<mail-authorization-code>
SECURITY_BOOTSTRAP_ADMIN_ENABLED=false
SECURITY_BOOTSTRAP_ADMIN_USERNAME=<initial-admin-username>
SECURITY_BOOTSTRAP_ADMIN_PASSWORD=<initial-admin-strong-password>
SECURITY_BOOTSTRAP_ADMIN_EMAIL=<initial-admin-email>
AI_ENABLED=false
AI_BASE_URL=<ai-api-base-url>
AI_API_KEY=<ai-api-key>
